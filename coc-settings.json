{
  "coc-qml.qmllsPath": "${env:QMLLS}",
  "coc-qml.qmlformatPath": "${env:QMLFORMAT}",
  "coc.preferences.formatOnType": true,
  "coc.preferences.formatOnSave": true,
  "coc.source.omni.filetypes": [
    "ocaml"
  ],
  "ada.serverBin": "${env:ADALS}",
  "eslint.enable": true,
  "eslint.run": "onSave",
  "eslint.useESLintClass": true,
  "eslint.experimental.useFlatConfig": true,
  "python.analysis.typeCheckingMode": "strict",
  "python.formatting.provider": "ruff",
  "python.linting.mypyEnabled": true,
  "python.linting.mypyArgs": [
    "--strict",
    "--no-pretty",
    "--show-column-number"
  ],
  "python.linting.pylintEnabled": true,
  "python.linting.ruffEnabled": true,
  "pyright.organizeimports.provider": "ruff",
  "pyright.inlayHints.functionReturnTypes": false,
  "pyright.inlayHints.variableTypes": false,
  "pyright.testing.provider": "pytest",
  "rust-analyzer.server.path": "rust-analyzer",
  "rust-analyzer.check.command": "clippy",
  "workspace.ignoredFolders": [
    "$HOME",
    "$HOME/.cargo/**",
    "$HOME/.rustup/**"
  ],
  "[zig]": {
    "coc.preferences.formatOnSave": true,
    "semanticTokens.enable": true
  },
  "[6502]": {
    "semanticTokens.enable": true
  },
  "[ez80]": {
    "semanticTokens.enable": true
  },
  "[z80]": {
    "semanticTokens.enable": true
  },
  "languageserver": {
    "zils_ez80": {
      "command": "zils",
      "args": [
        "--stdio"
      ],
      "filetypes": [
        "ez80"
      ]
    },
    "zils_z80": {
      "command": "zils",
      "args": [
        "--stdio",
        "--asmsx"
      ],
      "filetypes": [
        "z80"
      ]
    },
    "merls": {
      "command": "merls",
      "args": [
        "--stdio"
      ],
      "rootPatterns": [
        ".git"
      ],
      "filetypes": [
        "6502"
      ]
    },
    "millet": {
      "command": "millet-ls",
      "filetypes": [
        "sml"
      ],
      "rootPatterns": [
        "sources.cm",
        ".git/"
      ]
    },
    "alivelsp": {
      "filetypes": [
        "lisp"
      ],
      "host": "127.0.0.1",
      "port": 5000
    },
    "harper": {
      "command": "harper-ls",
      "args": [
        "--stdio"
      ],
      "filetypes": [
        "markdown"
      ]
    },
    "erlang": {
      "command": "erlang_ls",
      "filetypes": [
        "erlang"
      ]
    },
    "haskell": {
      "command": "haskell-language-server-wrapper",
      "args": [
        "--lsp"
      ],
      "rootPatterns": [
        "*.cabal",
        "stack.yaml",
        "cabal.project",
        "package.yaml",
        "hie.yaml"
      ],
      "filetypes": [
        "haskell",
        "lhaskell"
      ]
    },
    "prolog-lsp": {
      "command": "swipl",
      "args": [
        "-g",
        "use_module(library(lsp_server)).",
        "-g",
        "lsp_server:main",
        "-t",
        "halt",
        "--",
        "stdio"
      ],
      "filetypes": [
        "prolog"
      ]
    },
    "fortls": {
      "command": "fortls",
      "args": [
        "--lowercase_intrinsics"
      ],
      "filetypes": [
        "fortran"
      ]
    },
    "coffeesense": {
      "command": "coffeesense-language-server",
      "filetypes": [
        "coffee"
      ]
    },
    "cmake": {
      "command": "neocmakelsp",
      "args": [
        "stdio"
      ],
      "filetypes": [
        "cmake"
      ],
      "rootPatterns": [
        "build/"
      ],
      "initializationOptions": {
        "buildDirectory": "build"
      }
    },
    "awk-lsp": {
      "command": "awk-language-server",
      "filetypes": [
        "awk"
      ]
    },
    "elmlsp": {
      "command": "elm-language-server",
      "filetypes": [
        "elm"
      ],
      "rootPatterns": [
        "elm.json"
      ]
    },
    "ocamllsp": {
      "command": "ocamllsp",
      "filetypes": [
        "ocaml"
      ]
    },
    "unison": {
      "filetypes": [
        "unison"
      ],
      "host": "127.0.0.1",
      "port": 5757,
      "settings": {}
    },
    "zls": {
      "command": "zls",
      "filetypes": [
        "zig",
        "zon"
      ]
    }
  }
}
